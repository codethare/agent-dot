{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git",
    "@tarquinen/opencode-dcp@latest",
    "oh-my-openagent@latest"
  ],
  "permission": {
    "bash": {
      "*": "allow",
      "sudo *": "deny",
      "rm -rf *": "deny",
      "chmod 777 *": "deny",
      "mkfs.*": "deny",
      "dd *": "deny",
      "killall *": "deny",
      "pkill -9 *": "deny",
      "npm publish *": "deny",
      "git push --force *": "deny",
      "git push -f *": "deny",
      "git push --force-with-lease *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd *": "deny",
      "git checkout -- *": "deny",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/secrets/**": "deny",
      "**/credentials.json": "deny"
    },
    "edit": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "glob": "allow",
    "grep": "allow",
    "skill": "allow"
  },
  "compaction": {
    "auto": true,
    "strategy": "summarize",
    "threshold": 0.8,
    "prune_tool_outputs": true
  },
  "lsp": {
    "rust": {
      "command": [
        "rust-analyzer"
      ],
      "env": {
        "RUST_LOG": "debug"
      }
    },
    "typescript": {
      "disabled": true
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    }
  }
}
