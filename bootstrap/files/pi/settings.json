{
  "quietStartup": true,
  "tuiMode": "regular",
  "npmCommand": [
    "bun"
  ],
  "packages": [
    "npm:pi-subagents",
    "git:github.com/DietrichGebert/ponytail",
    "npm:pi-mcp-adapter",
    "npm:@ff-labs/pi-fff",
    "npm:pi-codex-goal",
    "npm:@quintinshaw/pi-dynamic-workflows",
    {
      "source": "npm:pi-skill-shiori",
      "extensions": [
        "-src/index.ts"
      ]
    },
    "npm:pi-web-access",
    "npm:context-mode",
    "npm:pi-commandcode-provider",
    "npm:@ogulcancelik/pi-ghost",
    "npm:pi-cache-optimizer",
    {
      "source": "npm:pi-sandbox",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:open-codebase-index",
    "npm:@juicesharp/rpiv-advisor",
    "npm:@narumitw/pi-retry",
    "git:github.com/obra/superpowers",
    "npm:pi-lens"
  ],
  "defaultProvider": "commandcode",
  "defaultModel": "deepseek/deepseek-v4.1-flash",
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultModel": "commandcode/deepseek/deepseek-v4.1-flash",
    "defaultThinking": "medium",
    "agentOverrides": {
      "oracle": {
        "model": "commandcode/claude-haiku-5-5"
      },
      "reviewer": {
        "model": "commandcode/claude-haiku-5-5"
      },
      "evidence-auditor": {
        "model": "commandcode/claude-haiku-5-5"
      },
      "worker": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash",
        "thinking": "medium"
      },
      "scout": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      },
      "researcher": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      },
      "delegate": {
        "model": "commandcode/deepseek/deepseek-v4.1-flash"
      }
    },
    "modelScope": {
      "enforce": true,
      "strict": false,
      "allow": [
        "inherit",
        "commandcode/deepseek/deepseek-v4.1-flash",
        "commandcode/claude-haiku-5-5"
      ]
    }
  },
  "hideThinkingBlock": true,
  "extensions": [
    "-builtin:mcp",
    "-extensions/pi-gzip.ts",
    "-extensions/next-suggestion.ts"
  ],
  "theme": "solarized-osaka"
}
