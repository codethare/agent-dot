{
  "enabled": true,
  "sandboxUserShell": false,
  "permissionPromptTimeoutSeconds": 600,
  "allowBrowserProcess": true,
  "network": {
    "allowLocalBinding": true,
    "allowAllUnixSockets": true,
    "allowUnauthenticatedSocksProxy": true,
    "disabled": false,
    "allowSSHAgentSocket": true,
    "allowedDomains": [
      "*.crates.io",
      "*.github.com",
      "*.githubusercontent.com",
      "*.lua.org",
      "*.luarocks.org",
      "*.nodejs.org",
      "*.npmjs.org",
      "*.pub.dev",
      "*.pypi.org",
      "*.python.org",
      "*.ruby-lang.org",
      "*.rubygems.org",
      "*.rust-lang.org",
      "127.0.0.1",
      "crates.io",
      "dl.google.com",
      "download.clojure.org",
      "download.java.net",
      "files.pythonhosted.org",
      "formulae.brew.sh",
      "ftpmirror.gnu.org",
      "ghcr.io",
      "github.com",
      "go.dev",
      "golang.org",
      "localhost",
      "luarocks.org",
      "nim-lang.org",
      "nodejs.org",
      "proxy.golang.org",
      "pub.dev",
      "pypi.org",
      "repo1.maven.org",
      "rubygems.org",
      "sh.rustup.rs",
      "storage.googleapis.com",
      "sum.golang.org",
      "ziglang.org",
      "ntfy.sh"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/Users",
      "/home",
      "/root",
      "~/.config/pi/agent/mcp-auth.json",
      "~/.config/pi/agent/telegram.json",
      "~/.pi/agent/mcp-auth.json",
      "~/.pi/agent/telegram.json"
    ],
    "allowRead": [".", "~/.config", "~/.local", "~/.pi"],
    "allowWrite": [".", "/tmp"],
    "denyWrite": [
      "*.key",
      "*.p12",
      "*.pem",
      "*.pfx",
      ".env",
      ".env.*",
      "~/.aws",
      "~/.bundle/config",
      "~/.claude/settings.json",
      "~/.config/claude/settings.json",
      "~/.config/gcloud",
      "~/.config/gh",
      "~/.config/pi/agent/auth.json",
      "~/.config/pi/agent/mcp-auth.json",
      "~/.config/pi/agent/telegram.json",
      "~/.config/rclone",
      "~/.gem/credentials",
      "~/.gnupg",
      "~/.local/share/cargo/credentials",
      "~/.local/share/cargo/credentials.toml",
      "~/.netrc",
      "~/.npmrc",
      "~/.ollama/id_ed25519",
      "~/.pi/agent/auth.json",
      "~/.pi/agent/mcp-auth.json",
      "~/.pi/agent/telegram.json",
      "~/.ssh"
    ]
  }
}
